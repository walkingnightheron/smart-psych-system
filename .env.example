# 智慧心理健康评估系统 环境变量配置示例（复制为 .env 使用，切勿提交真实密钥）
SPRING_PROFILES_ACTIVE=default

# 数据库连接
DB_URL=jdbc:mysql://localhost:3306/psych_assessment?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_mysql_password

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ 异步消息配置
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest

# JWT 签名密钥（至少32字节，生产/部署时请通过环境变量注入）
JWT_SECRET=replace_with_at_least_32_chars_random_jwt_secret_key
