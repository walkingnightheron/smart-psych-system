        JSON authorized_admin_ids
        DATETIME created_at
        DATETIME updated_at
    }

    ACTIVITY_PARTICIPANT {
        BIGINT id PK
        BIGINT activity_id FK
        BIGINT user_id FK
        DATETIME created_at
    }

    ANSWER_SHEET {
